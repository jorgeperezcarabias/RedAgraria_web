---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticuloCard from '../components/ArticuloCard.astro';

const articulos = (await getCollection('articulos')).sort(
  (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()
);
---

<Base titulo="Inicio">
  <h1>Últimos artículos</h1>
  <p class="intro">Actualidad, subvenciones y normativa del campo, resumidas y verificadas.</p>

  <ul class="grid">
    {articulos.map((articulo) => (
      <ArticuloCard
        id={articulo.id}
        titulo={articulo.data.titulo}
        resumen={articulo.data.resumen}
        tema={articulo.data.tema}
        fecha={articulo.data.fecha}
        imagen={articulo.data.imagen}
      />
    ))}
  </ul>
</Base>

<style>
  .intro {
    color: var(--text-muted);
    margin-top: 0.25rem;
    margin-bottom: 2.5rem;
    font-size: 1.05rem;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 480px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
